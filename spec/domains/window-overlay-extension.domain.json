    },
    {
      "pathPattern": "(^|/)overlay-app/src/((panels|markdown|lib)/[^/]+|App|main)\\.(jsx|js)$"
    },
    {
      "pathPattern": "(^|/)packages/charts/src/[^/]+\\.(jsx|js)$"
    },
    {
      "pathPattern": "(^|/)player-profile-server/(src/(local/overlayRoutes(?:\\.test)?|services/overlay/[^/]+)\\.js|spec/feature/window-overlay-extension\\.md)$"
