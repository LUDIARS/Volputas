# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
AUTH_SOURCES=google,discord
REDIS_URL=
VOLUPTAS_PSEUDO_ID_SECRET=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=player_profile
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20

# JWT
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=player-profile-client

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/callback

# CORS
CORS_ORIGIN=*

# Spectator sessions
SPECTATOR_STALE_SESSION_HOURS=24
SPECTATOR_MAINTENANCE_INTERVAL_MINUTES=60

# Spectator private media storage (S3-compatible)
MEDIA_S3_ENDPOINT=
# Browser-facing origin used only for presigned upload/download URLs.
# Omit when it is the same as MEDIA_S3_ENDPOINT.
MEDIA_S3_PUBLIC_ENDPOINT=
MEDIA_S3_REGION=ap-northeast-1
MEDIA_S3_BUCKET=volputas-media
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_UPLOAD_EXPIRES_SECONDS=900
MEDIA_DELIVERY_EXPIRES_SECONDS=300

# Spectator media worker
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CLAM_SCAN_PATH=clamscan
MEDIA_WORKER_POLL_SECONDS=5
MEDIA_ORIGINAL_RETENTION_DAYS=30
MEDIA_WORK_ROOT=
