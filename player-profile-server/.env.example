# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
AUTH_SOURCES=cernere
REDIS_URL=
VOLUPTAS_PSEUDO_ID_SECRET=

# Corpus / Cernere online mode
CERNERE_BASE_URL=http://localhost:3100
VOLPUTAS_AUDIENCE=
# Excubitor injects these launch credentials. Do not commit real values.
CERNERE_PROJECT_CLIENT_ID=
CERNERE_PROJECT_CLIENT_SECRET=
CERNERE_OIDC_CLIENT_ID=
CERNERE_OIDC_CLIENT_SECRET=
CERNERE_OIDC_CALLBACK_URL=http://localhost:3000/auth/callback
VOLPUTAS_MEDIA_ROOT=

# Database
VOLPUTAS_DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=player_profile
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20

# JWT
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=player-profile-client

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/callback

# CORS
CORS_ORIGIN=*

# Steam (ID linking + owned games import, https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Memoria personality-trend linking (AES-256-GCM key for memoria_links.token_ciphertext)
MEMORIA_LINK_ENCRYPTION_KEY=

# AI evaluation for emotion curves (optional; endpoint fails fast when unset)
ANTHROPIC_API_KEY=
VOLPUTAS_LLM_MODEL=

# Spectator sessions
SPECTATOR_STALE_SESSION_HOURS=24
SPECTATOR_MAINTENANCE_INTERVAL_MINUTES=60

# Spectator private media storage (S3-compatible)
MEDIA_S3_ENDPOINT=
# Browser-facing origin used only for presigned upload/download URLs.
# Omit when it is the same as MEDIA_S3_ENDPOINT.
MEDIA_S3_PUBLIC_ENDPOINT=
MEDIA_S3_REGION=ap-northeast-1
MEDIA_S3_BUCKET=volputas-media
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_UPLOAD_EXPIRES_SECONDS=900
MEDIA_DELIVERY_EXPIRES_SECONDS=300

# Spectator media worker
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CLAM_SCAN_PATH=clamscan
MEDIA_WORKER_POLL_SECONDS=5
MEDIA_ORIGINAL_RETENTION_DAYS=30
MEDIA_WORK_ROOT=
